# Copy to .env and chmod 600. Never commit the real file.

# --- Credential encryption (spec §4.4) ---
# 32 bytes, base64. Generate with:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CRED_KEY=

# Signs the single-use magic link for account linking (spec §4.1)
LINK_SECRET=

# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://groww:groww@localhost:5432/growwdesk
REDIS_URL=redis://localhost:6379/0

# --- Public base URL for the link page ---
PUBLIC_BASE_URL=https://desk.example.in

# --- Channel adapter ---
BAILEYS_URL=http://localhost:3001

# --- R2D2 / the GR-1 harness (docs/INTEGRATE_R2D2.md) ---
# Empty base URL = open questions get today's redirect line. Nothing else changes.
R2D2_BASE_URL=
R2D2_API_KEY=
R2D2_AUTH_HEADER=Authorization
R2D2_AUTH_SCHEME=Bearer
# An agentic loop over MCP tools; the typing indicator is kept alive throughout.
R2D2_TIMEOUT_S=45
# Streaming is read for liveness only. WhatsApp gets one message either way.
R2D2_STREAM=true
# Invariant I1. false sends answers with figures we cannot trace, and logs each
# one. For a single operator checking the pipe, never for the dogfooders.
R2D2_STRICT_NUMBERS=true
